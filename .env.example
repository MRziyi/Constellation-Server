# Constellation Server — copy to .env and fill in. .env is git-ignored; keep it that way.
# Everything below except OPENAI_API_KEY is optional and shown with its default.

# ── Credentials ───────────────────────────────────────────────────────────────
# Required. Used by the router, the classifier, vision, and twin_query.
OPENAI_API_KEY=

# Optional. Fast inference for latency-sensitive calls (the classifier by default).
GROQ_API_KEY=
# GROQ_BASE_URL=https://api.groq.com/openai/v1

# The agent path authenticates through the Claude Code CLI (subscription auth),
# so no Anthropic key is needed here unless you drive the SDK directly.

# ── Model selection ───────────────────────────────────────────────────────────
# The router/planner: turns an event into a dispatch plan.
# CORTEX_ROUTER_MODEL=gpt-5.2
# One cheap call per turn deciding SIMPLE vs COMPLEX. Keep this small and fast.
# CORTEX_CLASSIFIER_MODEL=openai/gpt-oss-120b

# Agent-path tiers. FAST handles most turns; DEEP is reserved for hard ones.
# CORTEX_AGENT_MODEL_FAST=claude-sonnet-4-6
# CORTEX_AGENT_MODEL_DEEP=claude-opus-4-8
# Set CORTEX_AGENT_MODEL to pin one model for every agent run (overrides the tiers).
# CORTEX_AGENT_MODEL=
# CORTEX_AGENT_FALLBACK_MODEL=
# Reasoning effort for the agent path: low | medium | high.
# CORTEX_AGENT_EFFORT=low
# Hard ceiling on what a single agent run may spend, in USD.
# CORTEX_SDK_MAX_BUDGET_USD=2.0

# ── Speech to text (local, whisper.cpp) ───────────────────────────────────────
# brew install whisper-cpp, then download ggml-base.bin + ggml-small.bin into
# ~/constellation/whisper-models/. Two tiers: base for the fast partial, small
# for the final transcript you review.
# WHISPER_CLI=/opt/homebrew/bin/whisper-cli
# WHISPER_SERVER=/opt/homebrew/bin/whisper-server

# ── Face recognition (on-device; never leaves the machine) ────────────────────
# InsightFace via onnxruntime + CoreML. The model downloads on first use.
# CONSTELLATION_FACE_MODEL=buffalo_l
# CONSTELLATION_FACE_THRESHOLD=0.40
# CONSTELLATION_FACE_DET_SIZE=640

# ── Insight engine (proactive surfacing) ──────────────────────────────────────
# Off by default: it pushes cards you did not ask for. Set to 1 to enable.
# CONSTELLATION_INSIGHT_ENGINE=0
# CONSTELLATION_INSIGHT_TICK_S=900
# CONSTELLATION_INSIGHT_COOLDOWN_S=600

# ── Inbound email → HUD ───────────────────────────────────────────────────────
# Path to a newline-separated allowlist of senders whose mail pushes a HUD card.
# Defaults to ~/constellation/twin/_system/mail_vips.txt.
# CONSTELLATION_MAIL_VIPS=

# ── Test harness ──────────────────────────────────────────────────────────────
# A mailbox you own. test-harness/mail_flow.py refuses to run without it.
# TEST_RECIPIENT=
